# ==============================================================================
# MOVISABIO ENTERPRISE SMART CITY PLATFORM // ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your deployment environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Core Data Storage & Caching (Redis)
REDIS_URL=redis://localhost:6379/0

# Persistent Database (PostgreSQL / PostGIS)
DATABASE_URL=postgresql+asyncpg://movisabio_admin:secure_db_password_change_me@localhost:5432/movisabio_db

# Security & Authentication Gateway
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production_min_256_bits
API_KEY_HEADER_NAME=X-MoviSabio-API-Key
MASTER_API_KEY=your_master_admin_api_key

# Cloud Ingestion & Edge Broker Integration (Azure IoT Hub / Kafka)
AZURE_IOT_HUB_CONNECTION_STRING=HostName=movisabio-hub.azure-devices.net;SharedAccessKeyName=iothubowner;SharedAccessKey=your_iot_hub_key
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1.movisabio.internal:9092,kafka-broker-2.movisabio.internal:9092

# Multi-Region Global Traffic Management (GTM) & Kubernetes Clustering
GLOBAL_REGION_CODE=EU_CENTRAL_FRANKFURT
K8S_INGRESS_DOMAIN=api.movisabio.internal

# Observability, Prometheus & Grafana
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# External Municipal Webhooks & Emergency Dispatch Integrations
EMERGENCY_DISPATCH_WEBHOOK_URL=https://cad.municipal-emergency.gov/api/v1/dispatch
WEBHOOK_SECRET_TOKEN=your_secure_webhook_hmac_secret

SECRET_KEY=your_super_secret_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/movisabio
