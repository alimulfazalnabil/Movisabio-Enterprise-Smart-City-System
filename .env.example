APP_NAME=MoviSabio
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql://user:password@localhost:5432/movisabio
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-me
JWT_ALGORITHM=RS256

CORS_ORIGINS=["http://localhost:3000"]

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

MQTT_BROKER=localhost
MQTT_PORT=1883

TRAFFIC_CONTROLLER_MODE=simulation
TRAFFIC_CONTROLLER_TIMEOUT=2.0
TRAFFIC_CONTROLLER_RETRY_LIMIT=3
SAFETY_VALIDATION=true
REQUIRE_CONTROLLER_ACKNOWLEDGEMENT=true
ALLOW_REMOTE_CONTROL=false
EMERGENCY_OVERRIDE_ENABLED=true
