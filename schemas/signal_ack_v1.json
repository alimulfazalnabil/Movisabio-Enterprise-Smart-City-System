{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "SignalAck",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "intersection_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "sequence_number": {
      "type": "integer"
    },
    "model_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "command_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACK",
        "NACK"
      ]
    },
    "actual_state": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "intersection_id",
    "timestamp",
    "producer",
    "sequence_number",
    "command_id",
    "status"
  ]
}