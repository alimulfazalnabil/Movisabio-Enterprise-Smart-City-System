{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleDetection",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "intersection_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "sequence_number": {
      "type": "integer"
    },
    "model_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_class": {
      "type": "string",
      "enum": [
        "car",
        "motorcycle",
        "bus",
        "truck",
        "bicycle",
        "pedestrian",
        "emergency vehicle"
      ]
    },
    "lane_id": {
      "type": "string"
    },
    "speed_kmh": {
      "type": "number"
    },
    "direction": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "intersection_id",
    "timestamp",
    "producer",
    "sequence_number",
    "vehicle_id",
    "vehicle_class"
  ]
}