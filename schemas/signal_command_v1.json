{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "SignalCommand",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "intersection_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "sequence_number": {
      "type": "integer"
    },
    "model_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "command_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "requested_state": {
      "type": "string",
      "enum": [
        "RED",
        "GREEN",
        "YELLOW",
        "ALL_RED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "operator": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "intersection_id",
    "timestamp",
    "producer",
    "sequence_number",
    "command_id",
    "phase",
    "requested_state"
  ]
}