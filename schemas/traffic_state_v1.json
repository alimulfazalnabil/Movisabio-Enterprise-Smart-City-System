{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "TrafficState",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "intersection_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "sequence_number": {
      "type": "integer"
    },
    "model_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "queues": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "average_speed": {
      "type": "number"
    },
    "congestion_index": {
      "type": "number"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "intersection_id",
    "timestamp",
    "producer",
    "sequence_number"
  ]
}